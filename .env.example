# AzTU E-Qrant backend configuration.
# Copy to .env and fill in real values. NEVER commit the real .env.
# (.env is already in .gitignore — see the security notes if it was committed
# before that rule and its secrets need rotating.)

# ---- Core ----
# Long random string used to sign JWTs. Rotate it if it was ever committed.
# Rotating it invalidates every existing token (users simply sign in again).
SECRET_KEY=change-me-to-a-long-random-secret
# SQLAlchemy database URL, e.g. postgresql://user:password@host:5432/egrant
DATABASE_URL=postgresql://user:password@host:5432/egrant
SQLALCHEMY_TRACK_MODIFICATIONS=False

# ---- CORS (pentest F5) ----
# Comma-separated allow-list of front-end origins permitted to call the API
# with credentials. Do NOT use "*". If unset, a sensible default covering the
# production front-ends and common local dev ports is used.
CORS_ORIGINS=https://e-grant.aztu.edu.az,https://admin-e-grant.aztu.edu.az

# ---- Public website -> API key ----
# The public Next.js site reads /api/public/* from its own server with this key
# (header X-Public-Api-Key). Set the SAME value as PUBLIC_API_KEY in the public
# site's environment. With no key set, /api/public/* refuses every request.
PUBLIC_API_KEY=generate-a-long-random-value

# ---- Reverse proxy / rate limiting ----
# Number of proxies in front of the app (1 = nginx). Used to read the real
# client IP from X-Forwarded-For. The app must listen on 127.0.0.1 only.
TRUSTED_PROXY_COUNT=1
# Shared rate-limit storage for multiple gunicorn workers (recommended):
# RATELIMIT_STORAGE_URI=redis://127.0.0.1:6379/0
RATELIMIT_STORAGE_URI=memory://
# Max request body in MB (uploads). Keep nginx client_max_body_size >= this.
MAX_UPLOAD_MB=100

# ---- API docs (pentest F11) ----
# Leave false in production. Set to true ONLY in a protected dev environment to
# expose the Swagger UI at /apidocs.
ENABLE_SWAGGER=false

# ---- E-mail (SMTP) ----
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=example@aztu.edu.az
# For Gmail this is an App Password, not the account password. Rotate if leaked.
SMTP_PASSWORD=your-app-password
# Optional: where user->admin message notifications are sent (defaults to SMTP_USER).
ADMIN_EMAIL=

# ---- Links inside e-mails ----
FRONTEND_URL=https://e-grant.aztu.edu.az

# ---- Uploads (optional; defaults to ../uploads) ----
# UPLOAD_FOLDER=/var/lib/egrant/uploads
